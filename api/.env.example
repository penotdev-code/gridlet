# Copy to .env and adjust.

# Local dev (zero setup): SQLite
DATABASE_URL=sqlite+aiosqlite:///./gridlet.db

# Production: Postgres (used by docker-compose service below)
# DATABASE_URL=postgresql+asyncpg://gridlet:gridlet@localhost:5432/gridlet

# CHANGE THIS in production — sign JWTs with a long random secret.
JWT_SECRET=dev-secret-change-me-in-production-please-32+chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
